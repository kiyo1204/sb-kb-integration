    "test:experiment-learner-browser": "tsx scripts/verify-experiment-learner-browser.ts",
    "test:r05-browser": "tsx scripts/verify-r05-browser.ts",
    "test:experiment-research-browser": "tsx scripts/verify-experiment-research-browser.ts",
