{
  "name": "research-mvp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write src index.html vite.config.ts package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src index.html vite.config.ts package.json tsconfig.json eslint.config.js",
    "test:delivery-browser": "tsx scripts/verify-delivery-browser.ts",
    "test:event-export-browser": "tsx scripts/verify-event-export-browser.ts",
    "test:data-management-browser": "tsx scripts/verify-data-management-browser.ts",
    "test:research-log-ui": "tsx scripts/verify-research-log-ui.ts",
    "test:link-position-browser": "tsx scripts/verify-link-position-browser.ts",
    "test:undo-role-browser": "tsx scripts/verify-undo-role-browser.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "playwright": "^1.64.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
