# Local development values only. Keep the password URL-safe because Compose
# uses it to construct DATABASE_URL for the API container.
POSTGRES_DB=research_mvp
POSTGRES_USER=research_mvp
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

FRONTEND_PORT=5173
API_PORT=3000

# Generate a unique secret of at least 32 characters. Do not commit the filled .env.
RESEARCHER_API_TOKEN=

# Bind development ports to this host address. Keep the default loopback binding.
STAGE1_BIND_ADDRESS=127.0.0.1
