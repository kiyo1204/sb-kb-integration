# Template only. Copy to .env.production-db (already gitignored); NEVER use dev .env.
# Pin an independently reviewed, official PostgreSQL 17-alpine multiarch digest.
# Enter 64 hex characters without the sha256: prefix.
SBKB_PROD_POSTGRES_DIGEST=

# Different from all rehearsal, development and mock databases.
SBKB_PROD_DB_NAME=sbkb_production
SBKB_PROD_DB_ADMIN_USER=sbkb_prod_admin

# Absolute path to an admin-only password file OUTSIDE this repository.
# Do not put a password, actual research token, or DB URL in this env file.
SBKB_PROD_DB_ADMIN_PASSWORD_FILE=
